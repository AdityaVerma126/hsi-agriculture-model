reds   = spatial_maps[name]['pred'][labeled_mask]\n    trues   = sal_labels[labeled_mask]\n    correct = (preds == trues)\n\n    oa_all = correct.mean() * 100\n    hc_sel = confs >= 0.85\n    oa_hc  = correct[hc_sel].mean() * 100 if hc_sel.sum() > 0 else 0\n    mc     = confs.mean() * 100\n    frac   = hc_sel.mean() * 100\n\n    bin_edges = np.linspace(0, 1, 21)\n    bin_mids  = 0.5 * (bin_edges[:-1] + bin_edges[1:])\n    ece = 0.0\n    for lo, hi, mid in zip(bin_edges[:-1], bin_edges[1:], bin_mids):\n        sel = (confs >= lo) & (confs < hi)\n        if sel.sum() > 0:\n            ece += np.abs(mid - correct[sel].mean()) * sel.sum()\n    ece /= len(confs)\n\n    print(f\"  {name:<18} {oa_all:>8.2f}% {oa_hc:>9.2f}% {mc:>9.1f}%\"\n          f\" {frac:>9.1f}% {ece:>8.4f}\")\n\nprint(\"═\" * 90)\nprint(f\"\\n  Outputs saved:\")\nfor f in ['salinas_confidence_maps.png',\n          'salinas_reliability_diagrams.png',\n          'salinas_ensemble_error_conf_map.png',\n          'salinas_threshold_sweep.png',\n          'salinas_per_class_confidence.png',\n          'salinas_threshold_conf_maps.png']:\n    print(f\"    {f}\")\nprint(\"\\n✅  Block 12C — Confidence Map Evaluation complete.\")","metadata":{"trusted":true,"execution":{"iopub.status.busy":"2026-04-19T14:47:54.390729Z","iopub.execute_input":"2026-04-19T14:47:54.391031Z","iopub.status.idle":"2026-04-19T14:50:57.669476Z","shell.execute_reply.started":"2026-04-19T14:47:54.391002Z","shell.execute_reply":"2026-04-19T14:50:57.668842Z"}},"outputs":[{"name":"stdout","text":"── Building spatial confidence maps ──\n\n  HVT                   OA=96.01%  mean_conf=0.895  frac>=85%=80.7%\n  ResNetHSI             OA=95.51%  mean_conf=0.927  frac>=85%=86.2%\n  DBAN                  OA=96.96%  mean_conf=0.937  frac>=85%=90.7%\n  MobileHSI             OA=94.65%  mean_conf=0.879  frac>=85%=72.8%\n  HGCN                  OA=92.57%  mean_conf=0.848  frac>=85%=63.3%\n  SpectralMamba         OA=95.72%  mean_conf=0.913  frac>=85%=83.6